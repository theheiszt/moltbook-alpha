# Environment configuration for Moltbook Alpha API
# Copy to .env for local overrides; never commit secrets.

APP_ENV=development
MOLTBOOK_DATA_DIR=./data
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_TREASURY_WALLET=DQkseq8m92h9mQbcQjDRSESAxphpAroKjqyGeSAoKCiC
ENABLE_DEMO_KEYS=false
# Webhook authentication secret for push-based settlement (e.g. Shyft / Helius webhooks)
WEBHOOK_SECRET=your_secure_webhook_secret_here
