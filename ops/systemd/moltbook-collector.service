[Unit]
Description=Moltbook Alpha Hourly Intelligence Ingestion & Signal Extraction
After=network.target moltbook-alpha.service

[Service]
Type=oneshot
User=moltbook-api
Group=moltbook-api
WorkingDirectory=/opt/moltbook-alpha/current
EnvironmentFile=-/etc/moltbook-alpha/api.env
Environment=PYTHONUNBUFFERED=1
Environment=APP_ENV=production
Environment=MOLTBOOK_DATA_DIR=/var/lib/moltbook-alpha
ReadWritePaths=/var/lib/moltbook-alpha /var/log/moltbook-alpha
ExecStart=/usr/local/sbin/moltbook-ops/collect.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=moltbook-collector
