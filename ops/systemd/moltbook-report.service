[Unit]
Description=Moltbook Alpha Daily Community Alpha Publisher & Report
After=moltbook-alpha.service

[Service]
Type=oneshot
User=moltbook-api
Group=moltbook-api
WorkingDirectory=/opt/moltbook-alpha/current
ExecStart=/usr/local/sbin/moltbook-ops/report.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=moltbook-report
