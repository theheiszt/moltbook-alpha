[Unit]
Description=Moltbook Alpha Weekly Isolated Restore Integrity Test
After=moltbook-backup.service

[Service]
Type=oneshot
User=moltbook-api
Group=moltbook-api
ExecStart=/opt/moltbook-alpha/current/ops/server/restore_test.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=moltbook-restore-test
