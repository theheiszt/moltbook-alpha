[Unit]
Description=Moltbook Alpha Weekly Isolated Restore Integrity Test
After=moltbook-backup.service

[Service]
Type=oneshot
User=moltbook-api
Group=moltbook-api
ExecStart=/usr/local/sbin/moltbook-ops/restore_test.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=moltbook-restore-test
